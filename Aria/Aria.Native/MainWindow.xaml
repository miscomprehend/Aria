<Window
    x:Class="Aria.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Aria">
    <Window.Resources>
        <Style x:Key="AriaNavigationButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="AriaActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="{StaticResource AriaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AriaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <Grid Background="#0A1018">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Grid.Row="0" Background="#0A1018" Margin="20,0,148,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Image x:Name="TitleBrandIcon" Width="24" Height="24" />
                <TextBlock Text="ARIA" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="NATIVE DESKTOP" FontSize="9" Foreground="#748394" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="LOCAL SESSION" FontSize="9" Foreground="#748394" VerticalAlignment="Center" />
                <Button x:Name="BrowserDashboardButton" Content="Browser panel" Click="BrowserDashboard_Click" Style="{StaticResource AriaActionButtonStyle}" />
                <Button Content="Website" Click="Website_Click" Style="{StaticResource AriaActionButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0D141B" BorderBrush="#273341" BorderThickness="0,1,1,0">
                <Grid Margin="14,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="5" Margin="6,5,6,18">
                        <TextBlock Text="Workspace" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="NATIVE CONTROL CENTER" FontSize="9" Foreground="#748394" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Navigation" Spacing="3">
                            <TextBlock Text="HOME" FontSize="9" FontWeight="SemiBold" Foreground="#748394" Margin="8,4,0,5" />
                            <Button Content="Overview" Tag="overview" Click="Navigation_Click" HorizontalContentAlignment="Left" Style="{StaticResource AriaNavigationButtonStyle}" />
                            <Button Content="Hosted instances" Tag="hosted" Click="Navigation_Click" HorizontalContentAlignment="Left" Style="{StaticResource AriaNavigationButtonStyle}" />
                            <TextBlock Text="ACCOUNT" FontSize="9" FontWeight="SemiBold" Foreground="#748394" Margin="8,16,0,5" />
                            <Button Content="Profile" Tag="profile" Click="Navigation_Click" HorizontalContentAlignment="Left" Style="{StaticResource AriaNavigationButtonStyle}" />
                            <Button Content="Friends" Tag="friends" Click="Navigation_Click" HorizontalContentAlignment="Left" Style="{StaticResource AriaNavigationButtonStyle}" />
                            <Button Content="Access" Tag="access" Click="Navigation_Click" HorizontalContentAlignment="Left" Style="{StaticResource AriaNavigationButtonStyle}" />
                            <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="SemiBold" Foreground="#748394" Margin="8,16,0,5" />
                            <Button Content="Status" Tag="presence" Click="Navigation_Click" HorizontalContentAlignment="Left" Style="{StaticResource AriaNavigationButtonStyle}" />
                            <Button Content="Presence studio" Tag="rpc" Click="Navigation_Click" HorizontalContentAlignment="Left" Style="{StaticResource AriaNavigationButtonStyle}" />
                            <Button Content="Commands" Tag="commands" Click="Navigation_Click" HorizontalContentAlignment="Left" Style="{StaticResource AriaNavigationButtonStyle}" />
                            <Button Content="Activity feed" Tag="history" Click="Navigation_Click" HorizontalContentAlignment="Left" Style="{StaticResource AriaNavigationButtonStyle}" />
                            <Button Content="Analytics" Tag="analytics" Click="Navigation_Click" HorizontalContentAlignment="Left" Style="{StaticResource AriaNavigationButtonStyle}" />
                            <TextBlock Text="TOOLS" FontSize="9" FontWeight="SemiBold" Foreground="#748394" Margin="8,16,0,5" />
                            <Button Content="Nitro" Tag="boost" Click="Navigation_Click" HorizontalContentAlignment="Left" Style="{StaticResource AriaNavigationButtonStyle}" />
                            <Button Content="Message logger" Tag="logger" Click="Navigation_Click" HorizontalContentAlignment="Left" Style="{StaticResource AriaNavigationButtonStyle}" />
                            <Button Content="Command controls" Tag="automation" Click="Navigation_Click" HorizontalContentAlignment="Left" Style="{StaticResource AriaNavigationButtonStyle}" />
                            <Button Content="Settings" Tag="settings" Click="Navigation_Click" HorizontalContentAlignment="Left" Style="{StaticResource AriaNavigationButtonStyle}" />
                            <Button Content="Runtime logs" Tag="logs" Click="Navigation_Click" HorizontalContentAlignment="Left" Style="{StaticResource AriaNavigationButtonStyle}" />
                            <Button x:Name="OwnerNavigationButton" Content="Owner tools" Tag="owner" Click="Navigation_Click" HorizontalContentAlignment="Left" Style="{StaticResource AriaNavigationButtonStyle}" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Spacing="8" Margin="4,0,4,8">
                        <TextBlock x:Name="SessionIdentity" Text="Connecting…" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <Border Height="1" Background="#273341" />
                        <TextBlock Text="WINDOWS NATIVE · NO WEBVIEW" FontSize="8" Foreground="#748394" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="30,25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Overview" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageSubtitle" Text="Your Aria runtime at a glance" FontSize="12" Foreground="#A4B1BF" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="PageStatus" Text="● READY" FontSize="10" Foreground="#83D6B0" VerticalAlignment="Center" />
                        <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" Style="{StaticResource AriaActionButtonStyle}" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PageContent" Spacing="14" />
                </ScrollViewer>
            </Grid>

            <Border x:Name="StatusOverlay" Grid.ColumnSpan="2" Background="#E60A1018" Padding="28">
                <Border Width="440" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#101821" BorderBrush="#34495E" BorderThickness="1" CornerRadius="14">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image x:Name="SetupBrandIcon" Width="34" Height="34" />
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="ARIA DESKTOP" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Text="PRIVATE LOCAL SETUP" FontSize="8" Foreground="#748394" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Connecting to your Aria runtime" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="StatusMessage" Text="Signing in to the local dashboard service…" Foreground="#A4B1BF" TextWrapping="Wrap" />
                        <ProgressRing x:Name="ConnectionProgress" IsActive="True" Width="28" Height="28" HorizontalAlignment="Left" />
                        <Button x:Name="RetryButton" Content="Retry connection" Click="Retry_Click" Visibility="Collapsed" HorizontalAlignment="Left" Style="{StaticResource AriaActionButtonStyle}" />
                        <StackPanel x:Name="LoginPanel" Spacing="10" Visibility="Collapsed">
                            <TextBox x:Name="LoginUsername" Header="Aria username" />
                            <PasswordBox x:Name="LoginPassword" Header="Aria password" />
                            <TextBox x:Name="LoginDiscordId" Header="Discord ID (for regular accounts)" />
                            <Button Content="Sign in" Click="Login_Click" HorizontalAlignment="Left" Style="{StaticResource AriaActionButtonStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="TokenSetupPanel" Spacing="10" Visibility="Collapsed">
                            <PasswordBox x:Name="SetupToken" Header="Discord account token" PasswordRevealMode="Peek" />
                            <CheckBox x:Name="RememberToken" Content="Remember token on this device" IsChecked="True" />
                            <TextBlock Text="Remembered tokens are stored in Aria's encrypted local config. Leave this unchecked to use it only for this session." Foreground="#A4B1BF" TextWrapping="Wrap" FontSize="12" />
                            <Button x:Name="SetupSubmitButton" Content="Verify account and continue" Click="SetupToken_Click" HorizontalAlignment="Left" Style="{StaticResource AriaActionButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
