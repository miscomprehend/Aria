<Window
    x:Class="Aria.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Aria">
    <Grid Background="#0A0F17">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Modern Top Bar -->
        <Border Grid.Row="0" Background="#0D1219" BorderBrush="#1a2332" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,16,0" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#1a3d52">
                        <Image x:Name="TitleBrandIcon" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="ARIA DESKTOP" FontSize="12" FontWeight="SemiBold" Foreground="#e6edf4" />
                        <TextBlock Text="NATIVE CONTROL CENTER" FontSize="8" FontWeight="Medium" Foreground="#7a8896" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Status & Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#0d1b28" BorderBrush="#1a3650" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusIndicator" Width="8" Height="8" Fill="#62d39a" />
                            <TextBlock x:Name="StatusText" Text="CONNECTED" FontSize="10" FontWeight="SemiBold" Foreground="#a5d8ff" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="BrowserDashboardButton" Content="🌐 Web Panel" Click="BrowserDashboard_Click" Style="{StaticResource AriaActionButtonStyle}" />
                    <Button Content="⚙ Settings" Click="Website_Click" Style="{StaticResource AriaActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Modern Sidebar -->
            <Border Grid.Column="0" Background="#0d1219" BorderBrush="#1a2332" BorderThickness="0,0,1,0">
                <Grid Margin="16,20,14,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Workspace Card -->
                    <Border Background="#101f2d" BorderBrush="#1a3d52" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="#1a3d52">
                                <Image x:Name="SidebarBrandIcon" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Aria Workspace" FontSize="13" FontWeight="SemiBold" Foreground="#e6edf4" />
                                <TextBlock Text="NATIVE DESKTOP" FontSize="8" FontWeight="Medium" Foreground="#7a8896" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
                        <StackPanel x:Name="Navigation" Spacing="2">
                            <!-- HOME SECTION -->
                            <TextBlock Text="HOME" FontSize="10" FontWeight="Bold" Foreground="#5a6f84" Margin="12,12,0,8" />
                            <Button Tag="overview" Click="Navigation_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Height="40" Style="{StaticResource AriaNavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE80F;" FontSize="16" Foreground="#69b7ff" />
                                    <TextBlock Grid.Column="1" Text="Overview" FontSize="13" FontWeight="Medium" Foreground="#e6edf4" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Tag="hosted" Click="Navigation_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Height="40" Style="{StaticResource AriaNavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7EF;" FontSize="16" Foreground="#69b7ff" />
                                    <TextBlock Grid.Column="1" Text="Instances" FontSize="13" FontWeight="Medium" Foreground="#e6edf4" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- ACCOUNT SECTION -->
                            <TextBlock Text="ACCOUNT" FontSize="10" FontWeight="Bold" Foreground="#5a6f84" Margin="12,16,0,8" />
                            <Button Tag="profile" Click="Navigation_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Height="40" Style="{StaticResource AriaNavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="#69b7ff" />
                                    <TextBlock Grid.Column="1" Text="Profile" FontSize="13" FontWeight="Medium" Foreground="#e6edf4" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Tag="friends" Click="Navigation_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Height="40" Style="{StaticResource AriaNavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE716;" FontSize="16" Foreground="#69b7ff" />
                                    <TextBlock Grid.Column="1" Text="Friends" FontSize="13" FontWeight="Medium" Foreground="#e6edf4" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Tag="access" Click="Navigation_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Height="40" Style="{StaticResource AriaNavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="#69b7ff" />
                                    <TextBlock Grid.Column="1" Text="Access" FontSize="13" FontWeight="Medium" Foreground="#e6edf4" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- WORKSPACE SECTION -->
                            <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="#5a6f84" Margin="12,16,0,8" />
                            <Button Tag="presence" Click="Navigation_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Height="40" Style="{StaticResource AriaNavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F8;" FontSize="16" Foreground="#69b7ff" />
                                    <TextBlock Grid.Column="1" Text="Status" FontSize="13" FontWeight="Medium" Foreground="#e6edf4" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Tag="rpc" Click="Navigation_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Height="40" Style="{StaticResource AriaNavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE734;" FontSize="16" Foreground="#69b7ff" />
                                    <TextBlock Grid.Column="1" Text="Rich Presence" FontSize="13" FontWeight="Medium" Foreground="#e6edf4" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Tag="commands" Click="Navigation_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Height="40" Style="{StaticResource AriaNavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE756;" FontSize="16" Foreground="#69b7ff" />
                                    <TextBlock Grid.Column="1" Text="Commands" FontSize="13" FontWeight="Medium" Foreground="#e6edf4" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Tag="history" Click="Navigation_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Height="40" Style="{StaticResource AriaNavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE81C;" FontSize="16" Foreground="#69b7ff" />
                                    <TextBlock Grid.Column="1" Text="History" FontSize="13" FontWeight="Medium" Foreground="#e6edf4" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Tag="analytics" Click="Navigation_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Height="40" Style="{StaticResource AriaNavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE9D2;" FontSize="16" Foreground="#69b7ff" />
                                    <TextBlock Grid.Column="1" Text="Analytics" FontSize="13" FontWeight="Medium" Foreground="#e6edf4" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- TOOLS SECTION -->
                            <TextBlock Text="TOOLS" FontSize="10" FontWeight="Bold" Foreground="#5a6f84" Margin="12,16,0,8" />
                            <Button Tag="boost" Click="Navigation_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Height="40" Style="{StaticResource AriaNavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE735;" FontSize="16" Foreground="#e9bd68" />
                                    <TextBlock Grid.Column="1" Text="Nitro Manager" FontSize="13" FontWeight="Medium" Foreground="#e6edf4" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Tag="logger" Click="Navigation_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Height="40" Style="{StaticResource AriaNavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="#62d39a" />
                                    <TextBlock Grid.Column="1" Text="Message Logger" FontSize="13" FontWeight="Medium" Foreground="#e6edf4" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Tag="automation" Click="Navigation_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Height="40" Style="{StaticResource AriaNavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="#62d39a" />
                                    <TextBlock Grid.Column="1" Text="Automation" FontSize="13" FontWeight="Medium" Foreground="#e6edf4" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Tag="settings" Click="Navigation_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Height="40" Style="{StaticResource AriaNavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="#9d9d9d" />
                                    <TextBlock Grid.Column="1" Text="Settings" FontSize="13" FontWeight="Medium" Foreground="#e6edf4" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Tag="logs" Click="Navigation_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Height="40" Style="{StaticResource AriaNavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="#9d9d9d" />
                                    <TextBlock Grid.Column="1" Text="Runtime Logs" FontSize="13" FontWeight="Medium" Foreground="#e6edf4" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="OwnerNavigationButton" Tag="owner" Click="Navigation_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Height="40" Style="{StaticResource AriaNavigationButtonStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7EF;" FontSize="16" Foreground="#ff7e87" />
                                    <TextBlock Grid.Column="1" Text="Owner Tools" FontSize="13" FontWeight="Medium" Foreground="#e6edf4" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Session Status Card -->
                    <Border Grid.Row="2" Background="#101f2d" BorderBrush="#1a3d52" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,16,0,0">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="SessionStatusDot" Width="8" Height="8" Fill="#e9bd68" VerticalAlignment="Center" />
                                <TextBlock x:Name="SessionStatusText" Text="CONNECTING" FontSize="9" FontWeight="SemiBold" Foreground="#e9bd68" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="SessionIdentity" Text="Connecting…" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="#e6edf4" />
                            <Border Height="1" Background="#1a3d52" />
                            <TextBlock Text="WINDOWS NATIVE APP" FontSize="8" FontWeight="Medium" Foreground="#7a8896" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Modern Main Content Area -->
            <Grid Grid.Column="1" Margin="28,20,32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="6">
                        <TextBlock x:Name="PageTitle" Text="Overview" FontSize="32" FontWeight="Bold" Foreground="#e6edf4" />
                        <TextBlock x:Name="PageSubtitle" Text="Your Aria runtime at a glance" FontSize="13" Foreground="#a6b4c3" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Background="#0f1b28" BorderBrush="#1a3650" BorderThickness="1" CornerRadius="8" Padding="12,6">
                            <TextBlock x:Name="PageStatus" Text="● READY" FontSize="10" FontWeight="SemiBold" Foreground="#62d39a" VerticalAlignment="Center" />
                        </Border>
                        <Button x:Name="RefreshButton" Content="🔄 Refresh" Click="Refresh_Click" Style="{StaticResource AriaActionButtonStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Modern Content Container -->
                <Border Grid.Row="1" Background="#0f1b28" BorderBrush="#1a3650" BorderThickness="1" CornerRadius="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                        <StackPanel x:Name="PageContent" Spacing="18" Margin="24,24,24,24" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Modern Status Overlay -->
            <Border x:Name="StatusOverlay" Grid.ColumnSpan="2" Background="#CC000000" Padding="32">
                <Border Width="500" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#121f2d" BorderBrush="#1a3d52" BorderThickness="1" CornerRadius="14">
                    <StackPanel Spacing="16">
                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="42" Height="42" CornerRadius="10" Background="#1a3d52">
                                <Image x:Name="SetupBrandIcon" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="ARIA DESKTOP" FontSize="11" FontWeight="Bold" Foreground="#e6edf4" />
                                <TextBlock Text="NATIVE SETUP" FontSize="9" FontWeight="Medium" Foreground="#7a8896" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Title -->
                        <TextBlock Text="Connecting to your Aria runtime" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#e6edf4" />

                        <!-- Message -->
                        <TextBlock x:Name="StatusMessage" Text="Signing in to the local dashboard service…" Foreground="#a6b4c3" TextWrapping="Wrap" FontSize="13" />

                        <!-- Progress Ring -->
                        <ProgressRing x:Name="ConnectionProgress" IsActive="True" Width="32" Height="32" HorizontalAlignment="Left" Margin="0,8,0,0" />

                        <!-- Retry Button -->
                        <Button x:Name="RetryButton" Content="↻ Retry Connection" Click="Retry_Click" Visibility="Collapsed" HorizontalAlignment="Left" Style="{StaticResource AriaPrimaryButtonStyle}" Margin="0,8,0,0" />

                        <!-- Login Panel -->
                        <StackPanel x:Name="LoginPanel" Spacing="12" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBox x:Name="LoginUsername" Header="Aria Username" PlaceholderText="Enter your username" />
                            <PasswordBox x:Name="LoginPassword" Header="Password" />
                            <TextBox x:Name="LoginDiscordId" Header="Discord ID" PlaceholderText="For regular accounts" />
                            <Button Content="Sign In" Click="Login_Click" HorizontalAlignment="Left" Style="{StaticResource AriaPrimaryButtonStyle}" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Token Setup Panel -->
                        <StackPanel x:Name="TokenSetupPanel" Spacing="12" Visibility="Collapsed" Margin="0,8,0,0">
                            <PasswordBox x:Name="SetupToken" Header="Discord Account Token" />
                            <CheckBox x:Name="RememberToken" Content="Remember token on this device" IsChecked="True" Foreground="#e6edf4" />
                            <TextBlock Text="Tokens are stored encrypted. Uncheck to use only this session." Foreground="#a6b4c3" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                            <Button x:Name="SetupSubmitButton" Content="Verify &amp; Continue" Click="SetupToken_Click" HorizontalAlignment="Left" Style="{StaticResource AriaPrimaryButtonStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
