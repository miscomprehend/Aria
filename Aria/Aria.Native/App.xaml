<Application
    x:Class="Aria.Native.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Modern 2026 Color Palette -->
            <Color x:Key="AriaAccentColor">#69B7FF</Color>
            <Color x:Key="AriaLightAccentColor">#A5D8FF</Color>
            <Color x:Key="AriaSuccessColor">#62D39A</Color>
            <Color x:Key="AriaWarningColor">#E9BD68</Color>
            <Color x:Key="AriaDangerColor">#FF7E87</Color>
            <Color x:Key="AriaTextColor">#EDF3F9</Color>
            <Color x:Key="AriaMutedColor">#A6B4C3</Color>
            <Color x:Key="AriaBgDarkColor">#0A0F17</Color>
            <Color x:Key="AriaBgColor">#0D1219</Color>
            <Color x:Key="AriaBgLightColor">#0F1B28</Color>
            <Color x:Key="AriaBgSurfaceColor">#101F2D</Color>
            <Color x:Key="AriaBorderColor">#1A3650</Color>
            <Color x:Key="AriaBorderMutedColor">#1A2332</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="AriaAccentBrush" Color="{StaticResource AriaAccentColor}" />
            <SolidColorBrush x:Key="AriaLightAccentBrush" Color="{StaticResource AriaLightAccentColor}" />
            <SolidColorBrush x:Key="AriaSuccessBrush" Color="{StaticResource AriaSuccessColor}" />
            <SolidColorBrush x:Key="AriaWarningBrush" Color="{StaticResource AriaWarningColor}" />
            <SolidColorBrush x:Key="AriaDangerBrush" Color="{StaticResource AriaDangerColor}" />
            <SolidColorBrush x:Key="AriaTextBrush" Color="{StaticResource AriaTextColor}" />
            <SolidColorBrush x:Key="AriaMutedBrush" Color="{StaticResource AriaMutedColor}" />
            <SolidColorBrush x:Key="AriaWindowBrush" Color="{StaticResource AriaBgDarkColor}" />
            <SolidColorBrush x:Key="AriaSidebarBrush" Color="{StaticResource AriaBgColor}" />
            <SolidColorBrush x:Key="AriaContentBrush" Color="{StaticResource AriaBgLightColor}" />
            <SolidColorBrush x:Key="AriaSurfaceBrush" Color="{StaticResource AriaBgSurfaceColor}" />
            <SolidColorBrush x:Key="AriaRaisedBrush" Color="{StaticResource AriaBgSurfaceColor}" />
            <SolidColorBrush x:Key="AriaBorderBrush" Color="{StaticResource AriaBorderColor}" />
            <SolidColorBrush x:Key="AriaBorderMutedBrush" Color="{StaticResource AriaBorderMutedColor}" />
            <SolidColorBrush x:Key="AriaHoverBrush" Color="#192A3A" />
            <SolidColorBrush x:Key="AriaPressedBrush" Color="#20384D" />
            <SolidColorBrush x:Key="AriaNavActiveBrush" Color="#142A3C" />
            <SolidColorBrush x:Key="AriaSectionBrush" Color="#5A6F84" />

            <!-- Control Brushes -->
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#192A3A" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1A3F5F" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#2D6FA3" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#69B7FF" />
            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource AriaBgSurfaceColor}" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource AriaTextColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource AriaBorderColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0A1018" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#667584" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#1E2A36" />
            
            <!-- Text Box Brushes -->
            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource AriaBgLightColor}" />
            <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource AriaTextColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8393A3" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource AriaBorderColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0F2335" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F4F8FC" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3D7FB1" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#112F48" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F4F8FC" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#69B7FF" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#0A1018" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#667584" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#1E2A36" />

            <!-- ComboBox Brushes -->
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource AriaBgLightColor}" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource AriaTextColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource AriaBorderColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#0F2335" />
            <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#F4F8FC" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#3D7FB1" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#12263A" />
            <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#F4F8FC" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#69B7FF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#112F48" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#F4F8FC" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#69B7FF" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource AriaBgSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource AriaBorderColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#1A3F5F" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#0F2D48" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#69B7FF" />

            <!-- Checkbox & Radio Brushes -->
            <SolidColorBrush x:Key="CheckBoxForeground" Color="#DCE5EE" />
            <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#F4F8FC" />
            <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#F4F8FC" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillOn" Color="#69B7FF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillOnPointerOver" Color="#91D4FF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillOnPressed" Color="#5FADE0" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeOn" Color="#69B7FF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundOn" Color="#0A0F17" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillOff" Color="{StaticResource AriaBgLightColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillOffPointerOver" Color="#1A3F5F" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeOff" Color="#435669" />

            <!-- Radio Button Brushes -->
            <SolidColorBrush x:Key="RadioButtonForeground" Color="#DCE5EE" />
            <SolidColorBrush x:Key="RadioButtonForegroundPointerOver" Color="#F4F8FC" />
            <SolidColorBrush x:Key="RadioButtonForegroundPressed" Color="#F4F8FC" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFill" Color="{StaticResource AriaBgLightColor}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="#435669" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePointerOver" Color="#69B7FF" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePressed" Color="#69B7FF" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeChecked" Color="#69B7FF" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#69B7FF" />

            <!-- Toggle & Scroll Brushes -->
            <SolidColorBrush x:Key="ToggleSwitchTrackFillOn" Color="#2D668A" />
            <SolidColorBrush x:Key="ToggleSwitchTrackFillOnPointerOver" Color="#397AA3" />
            <SolidColorBrush x:Key="ToggleSwitchTrackFillOnPressed" Color="#1F4A6A" />
            <SolidColorBrush x:Key="ToggleSwitchTrackFillOff" Color="#263544" />
            <SolidColorBrush x:Key="ToggleSwitchTrackFillOffPointerOver" Color="#354A5D" />
            <SolidColorBrush x:Key="ToggleSwitchTrackStrokeOff" Color="#435669" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#69B7FF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#A6B4C3" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="{StaticResource AriaBgDarkColor}" />
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#69B7FF" />
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="{StaticResource AriaBgColor}" />
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="{StaticResource AriaBgSurfaceColor}" />
            <SolidColorBrush x:Key="ScrollBarPanningThumbFill" Color="#50667B" />
            <SolidColorBrush x:Key="ScrollBarPanningThumbFillPointerOver" Color="#69B7FF" />
            <SolidColorBrush x:Key="ScrollBarPanningThumbFillPressed" Color="#91D4FF" />

            <!-- Content Dialog Brushes -->
            <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource AriaBgSurfaceColor}" />
            <SolidColorBrush x:Key="ContentDialogForeground" Color="{StaticResource AriaTextColor}" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource AriaBorderColor}" />
            <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackground" Color="#69B7FF" />
            <SolidColorBrush x:Key="ContentDialogPrimaryButtonForeground" Color="#0A0F17" />
            <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackgroundPointerOver" Color="#91D4FF" />
            <SolidColorBrush x:Key="ContentDialogSecondaryButtonBackground" Color="{StaticResource AriaBgLightColor}" />
            <SolidColorBrush x:Key="ContentDialogSecondaryButtonForeground" Color="{StaticResource AriaTextColor}" />
            <SolidColorBrush x:Key="ContentDialogSecondaryButtonBackgroundPointerOver" Color="{StaticResource AriaBgSurfaceColor}" />

            <!-- Navigation & Styles -->
            <SolidColorBrush x:Key="ToolTipBackground" Color="#172331" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="#E6EDF4" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#354A5D" />
            <Style TargetType="Button">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="PasswordRevealMode" Value="Visible" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="11,6" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style TargetType="NumberBox">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style TargetType="ToggleSwitch">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="AriaNavigationButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Padding" Value="11,7" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
            <Style x:Key="AriaActionButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="13,7" />
                <Setter Property="Background" Value="{StaticResource AriaSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AriaBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="AriaPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AriaActionButtonStyle}">
                <Setter Property="Background" Value="{StaticResource AriaAccentBrush}" />
                <Setter Property="Foreground" Value="#07111B" />
                <Setter Property="BorderBrush" Value="{StaticResource AriaAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
