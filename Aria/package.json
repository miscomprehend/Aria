{
  "name": "aria-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Aria desktop app with a native Windows dashboard",
  "main": "electron/main.cjs",
  "scripts": {
    "build:native": "node scripts/build-native.cjs",
    "start": "npm run build:native && electron .",
    "build:backend": "python -m PyInstaller --noconfirm --clean --distpath build/pyinstaller-dist --workpath build/pyinstaller-work aria.spec",
    "dist": "npm run build:backend && npm run build:native && electron-builder"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.aria.desktop",
    "productName": "Aria",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/pyinstaller-dist/Aria",
        "to": "aria-backend"
      },
      {
        "from": "build/native",
        "to": "aria-native"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "electron/aria.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aria",
      "installerIcon": "electron/aria.ico",
      "uninstallerIcon": "electron/aria.ico",
      "installerHeaderIcon": "electron/aria.ico"
    }
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "electron-winstaller@5.4.0": true
  }
}
